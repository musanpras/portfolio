---
import { experience } from '../data/profile';
---

<section class="section section--alt" id="experience" aria-labelledby="experience-title">
  <div class="wrap section-intro" data-reveal>
    <h2 id="experience-title" class="headline">Experience.</h2>
    <p class="subhead">Five years, from games and web to native iOS.</p>
  </div>

  <div class="wrap">
    <ol class="roles" role="list" data-reveal>
      {
        experience.map((job) => (
          <li class="role">
            <div class="who">
              <h3>{job.company}</h3>
              <p class="title">{job.title}</p>
            </div>
            <p class="summary">{job.summary}</p>
            <p class="when">
              {job.start} to {job.end}
              <span>{job.location}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .roles {
    margin: 0;
    border-radius: var(--radius-tile);
    background: var(--bg);
    padding-inline: clamp(1.25rem, 0.75rem + 2.5vw, 2.5rem);
  }

  .role {
    display: grid;
    gap: 0.4rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--hair);
  }

  .role:first-child {
    border-top: 0;
  }

  @media (min-width: 820px) {
    .role {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) minmax(0, 2.2fr);
      align-items: baseline;
    }
  }

  h3 {
    font-size: 19px;
    letter-spacing: 0.012em;
  }

  .title {
    color: var(--text-2);
    font-size: 15px;
  }

  .summary {
    font-size: 17px;
  }

  .when {
    color: var(--text-2);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .when span {
    display: block;
  }

  @media (min-width: 820px) {
    .when {
      text-align: right;
    }
  }
</style>
