---
import { specs, background } from '../data/profile';
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="wrap section-intro" data-reveal>
    <h2 id="skills-title" class="headline">Skills.</h2>
    <p class="subhead">Apple platforms first.</p>
  </div>

  <div class="wrap">
    <dl class="specs" data-reveal>
      {
        specs.map((row) => (
          <div class="row">
            <dt>{row.label}</dt>
            <dd>{row.items.join(', ')}</dd>
          </div>
        ))
      }
      {
        background.map((row) => (
          <div class="row">
            <dt>{row.label}</dt>
            <dd>
              {row.lines.map((line) => (
                <p>
                  {line.main}
                  <span>{line.note}</span>
                </p>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .specs {
    border-top: 1px solid var(--hair);
  }

  .row {
    display: grid;
    gap: 0.3rem 2rem;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--hair);
  }

  @media (min-width: 720px) {
    .row {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    }
  }

  dt {
    font-weight: 600;
    font-size: 17px;
  }

  dd {
    display: grid;
    gap: 0.6rem;
    color: var(--text);
  }

  dd span {
    display: block;
    color: var(--text-2);
    font-size: 14px;
  }
</style>
