---
import { Image } from 'astro:assets';
import FrameDemo from './FrameDemo.astro';
import ScreenStrip from './ScreenStrip.astro';

import moraIcon from '../assets/icons/mora.png';
import tripzeeIcon from '../assets/icons/tripzee.png';
import tteryIcon from '../assets/icons/ttery.png';
import saraIcon from '../assets/icons/sara.png';

import tz1 from '../assets/shots/tripzee-1.jpg';
import tz2 from '../assets/shots/tripzee-2.jpg';
import tz3 from '../assets/shots/tripzee-3.jpg';
import tz4 from '../assets/shots/tripzee-4.jpg';
import tz5 from '../assets/shots/tripzee-5.jpg';
import ttHome from '../assets/shots/ttery-home.jpg';
import ttMarket from '../assets/shots/ttery-marketplace.jpg';
import ttWarn from '../assets/shots/ttery-warning.jpg';

const tripzeeShots = [
  { src: tz1, alt: 'Tripzee App Store screenshot: plan your trip easily, with peace of mind.' },
  { src: tz2, alt: 'Tripzee trip setup: destination, category and travel dates.' },
  { src: tz3, alt: 'Tripzee packing record with a weather-aware checklist for a city tour.' },
  { src: tz4, alt: 'Tripzee camera scan: spread items out and scan them all at once.' },
  { src: tz5, alt: 'Tripzee trip summary comparing what was packed with what came back.' },
];

const tteryShots = [
  { src: ttHome, alt: 'Ttery home screen: pick a task, with an energy battery bar and tasks like exercise, meal and shower.' },
  { src: ttMarket, alt: 'Ttery market: tasks grouped into draining and energizing, such as cook, work, study and laundry.' },
  { src: ttWarn, alt: 'Ttery warning: you do not have enough energy to do this task right now.' },
];

const saraSteps = [
  { title: 'AI proposes', text: 'A typed plan from your words. Never a date.' },
  { title: 'SARA validates', text: 'Targets, permissions and conflicts, checked in Swift.' },
  { title: 'EventKit executes', text: 'Deletions always ask you first.' },
  { title: 'SARA verifies', text: 'Every write is read back before it answers.' },
];
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap section-intro" data-reveal>
    <h2 id="work-title" class="headline">Selected work.</h2>
    <p class="subhead">Built at Apple Developer Academy in 2026. Most of it runs on the device, offline.</p>
  </div>

  <div class="wrap-wide tiles">
    <!-- Mora -->
    <article class="tile" id="mora" aria-labelledby="mora-title" data-reveal>
      <header class="tile-head">
        <Image class="icon" src={moraIcon} alt="" width={160} height={160} />
        <h3 id="mora-title" translate="no">Mora</h3>
        <p class="tagline">Messaging when there’s no signal.</p>
        <p class="body">
          Phones pair with an ESP32 over Bluetooth and talk over LoRa radio, so disaster volunteers stay in touch
          on the mountain. I designed the frame protocol that fits text, photos and voice notes into the radio’s
          small budget.
        </p>
        <p class="stack">Swift, SwiftUI, CoreBluetooth, LoRa, App Intents, HealthKit, Core ML</p>
        <p class="status">Team project. Available on TestFlight.</p>
      </header>
      <div class="tile-media">
        <FrameDemo />
      </div>
    </article>

    <!-- Tripzee -->
    <article class="tile" id="tripzee" aria-labelledby="tripzee-title" data-reveal>
      <header class="tile-head">
        <Image class="icon" src={tripzeeIcon} alt="" width={160} height={160} />
        <h3 id="tripzee-title" translate="no">Tripzee</h3>
        <p class="tagline">Pack smarter. Know what to bring.</p>
        <p class="body">
          Scan your things and Tripzee recognizes them on the device, with no internet. Packing lists adapt to
          the weather where you’re going.
        </p>
        <p class="stack">SwiftUI, Core ML, Vision, MobileCLIP, WeatherKit</p>
        <p class="links">
          <a class="btn btn--small" href="https://apps.apple.com/id/app/tripzee-plan-your-trip-easily/id6786098866" target="_blank" rel="noopener">View on the App Store</a>
          <a class="more" href="https://tripzee-topaz.vercel.app" target="_blank" rel="noopener">Privacy policy</a>
        </p>
      </header>
      <div class="tile-media tile-media--wide">
        <ScreenStrip label="Tripzee screenshots" shots={tripzeeShots} />
      </div>
    </article>

    <!-- Ttery -->
    <article class="tile" id="ttery" aria-labelledby="ttery-title" data-reveal>
      <header class="tile-head">
        <Image class="icon" src={tteryIcon} alt="" width={160} height={160} />
        <h3 id="ttery-title" translate="no">Ttery</h3>
        <p class="tagline">Plan your day around your energy.</p>
        <p class="body">
          Tasks drain or recharge your battery, and Ttery warns you before you pick one you can’t afford. I was
          the primary developer.
        </p>
        <p class="stack">SwiftUI, SwiftData, WidgetKit, MVVM</p>
        <p class="links">
          <a class="btn btn--small" href="https://apps.apple.com/id/app/ttery/id6776476060" target="_blank" rel="noopener">View on the App Store</a>
          <a class="more" href="https://ttery-navy.vercel.app" target="_blank" rel="noopener">Privacy policy</a>
        </p>
      </header>
      <div class="tile-media tile-media--wide">
        <ScreenStrip label="Ttery screenshots" shots={tteryShots} />
      </div>
    </article>

    <!-- SARA -->
    <article class="tile" id="sara" aria-labelledby="sara-title" data-reveal>
      <header class="tile-head">
        <Image class="icon icon--sara" src={saraIcon} alt="" width={160} height={160} />
        <h3 id="sara-title" translate="no">SARA</h3>
        <p class="tagline">Talk to your calendar.</p>
        <p class="body">
          Say what you need and SARA creates the event or reminder. A local parser handles common commands;
          Apple Foundation Models handle the rest, on the device. Solo project.
        </p>
        <p class="stack">Swift, SwiftUI, Foundation Models, EventKit, Speech, SwiftData</p>
        <p class="links">
          <a class="btn btn--small" href="https://github.com/musanpras/SARA" target="_blank" rel="noopener">View on GitHub</a>
        </p>
      </header>
      <div class="tile-media">
        <ol class="steps" role="list" aria-label="How SARA handles a request">
          {
            saraSteps.map((step, i) => (
              <li>
                <span class="step-num">{i + 1}</span>
                <h4>{step.title}</h4>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </article>
  </div>

  <div class="wrap also" data-reveal>
    <p>
      Also built <strong>StockLearn</strong>, stock-trading lessons with quizzes and Swift Charts.
    </p>
    <a class="more" href="https://github.com/musanpras" target="_blank" rel="noopener">More on GitHub</a>
  </div>
</section>

<style>
  .tiles {
    display: grid;
    gap: 20px;
  }

  .tile {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    padding: clamp(2.75rem, 2rem + 3.5vw, 5rem) clamp(1.1rem, 0.5rem + 3vw, 4rem);
    border-radius: var(--radius-tile);
    background: var(--tile);
    overflow: hidden;
    scroll-margin-top: 64px;
  }

  .tile-head {
    display: grid;
    justify-items: center;
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }

  .tile-head :global(.icon) {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-icon);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--text) 8%, transparent);
    margin-bottom: 1.25rem;
  }

  .tile-head :global(.icon--sara) {
    background: #1d1452;
  }

  h3 {
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.003em;
  }

  .tagline {
    margin-top: 0.35rem;
    font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.75rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--text-2);
  }

  .body {
    margin-top: 1.1rem;
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.42;
  }

  .stack {
    margin-top: 1rem;
    color: var(--text-2);
    font-size: 14px;
    letter-spacing: -0.01em;
  }

  .status {
    margin-top: 0.3rem;
    color: var(--text-2);
    font-size: 14px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
  }

  .tile-media {
    min-width: 0;
    width: 100%;
    max-width: 920px;
    margin-inline: auto;
  }

  .tile-media--wide {
    max-width: none;
  }

  /* SARA: a real four-step sequence */
  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
  }

  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .steps li {
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.5rem) clamp(0.9rem, 0.7rem + 1vw, 1.25rem);
    border-radius: 18px;
    background: var(--tile-inner);
    text-align: left;
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-size: 14px;
    font-weight: 600;
  }

  .steps h4 {
    margin-top: 1rem;
    font-size: 19px;
    letter-spacing: 0.01em;
  }

  .steps p {
    margin-top: 0.3rem;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.4;
  }

  .also {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    text-align: center;
    color: var(--text-2);
  }

  .also strong {
    color: var(--text);
    font-weight: 600;
  }

  .also .more {
    margin-top: 0.35rem;
  }
</style>
