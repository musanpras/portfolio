---
import { profile } from '../data/profile';

const links = [
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'GitHub', href: profile.links.github },
  { label: 'App Store', href: profile.links.appStore },
];
---

<section class="section section--alt contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap" data-reveal>
    <h2 id="contact-title" class="headline">Let’s talk.</h2>
    <p class="subhead">Open to iOS roles. On-site, hybrid or remote, and happy to relocate.</p>

    <div class="email-row">
      <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
      <button class="btn btn--ghost btn--small" type="button" data-copy={profile.email}>
        <span data-copy-label>Copy email</span>
      </button>
      <span class="visually-hidden" role="status" data-copy-status></span>
    </div>

    <ul class="links" role="list">
      {
        links.map((l) => (
          <li>
            <a class="more" href={l.href} target="_blank" rel="noopener me">
              {l.label}
            </a>
          </li>
        ))
      }
      <li><a class="more" href={profile.resume} download>Résumé</a></li>
    </ul>

    <p class="where">Based in {profile.location}.</p>
  </div>
</section>

<style>
  .contact {
    text-align: center;
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.25rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .email {
    font-size: clamp(1.3rem, 0.9rem + 2vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2rem;
    margin: 2rem 0 0;
    font-size: 17px;
  }

  .where {
    margin-top: 2rem;
    color: var(--text-2);
    font-size: 14px;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = button?.querySelector<HTMLElement>('[data-copy-label]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  let reset: number | undefined;

  button?.addEventListener('click', async () => {
    const email = button.dataset.copy ?? '';
    let ok = false;
    try {
      await navigator.clipboard.writeText(email);
      ok = true;
    } catch {
      // Clipboard can be blocked; select the address so it can be copied by hand.
      const link = document.querySelector('.email');
      if (link) {
        const range = document.createRange();
        range.selectNodeContents(link);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    }
    if (label) label.textContent = ok ? 'Copied' : 'Selected';
    if (status) status.textContent = ok ? 'Email address copied' : 'Email address selected';
    window.clearTimeout(reset);
    reset = window.setTimeout(() => {
      if (label) label.textContent = 'Copy email';
      if (status) status.textContent = '';
    }, 2000);
  });
</script>
