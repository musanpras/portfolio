---
import { profile } from '../data/profile';
---

<section class="hero wrap" id="top" aria-labelledby="hero-title">
  <p class="status reveal" style="--i: 0">
    <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    {profile.availability}
  </p>

  <h1 id="hero-title" class="reveal" style="--i: 1">
    Native iOS apps that keep working when the signal drops.
  </h1>

  <div class="intro">
    <p class="lead reveal" style="--i: 2">
      I’m Sandy, an iOS engineer in Bali. I helped rebuild Pegadaian’s main app in SwiftUI, shipped two apps to
      the App Store this year, and built a messenger that sends photos over LoRa radio where there is no cell
      coverage.
    </p>

    <div class="actions reveal" style="--i: 3">
      <a class="btn btn--solid" href="#work">See my work</a>
      <a class="btn" href={profile.resume} download>
        <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
          ><path d="M10 3v10M5.5 8.5 10 13l4.5-4.5M4 16.5h12"></path></svg
        >
        Download résumé (PDF)
      </a>
    </div>
  </div>

  <dl class="facts reveal" style="--i: 4">
    <div>
      <dt>Tring! by Pegadaian</dt>
      <dd>Part of the team that rebuilt it in native SwiftUI. 10M+ downloads on Google Play.</dd>
    </div>
    <div>
      <dt>Two apps on the App Store</dt>
      <dd>Tripzee and Ttery, built at Apple Developer Academy @ BINUS in 2026.</dd>
    </div>
    <div>
      <dt>5+ years shipping</dt>
      <dd>Mobile and web, from React Native and Flutter to Swift and on-device AI.</dd>
    </div>
  </dl>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 2rem + 6vw, 7.5rem);
    padding-bottom: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
    flex: none;
  }

  .bars i {
    width: 3px;
    border-radius: 1px;
    background: var(--signal-off);
    animation: bar 0.4s var(--ease) both;
  }

  .bars i:nth-child(1) { height: 35%; animation-delay: 0.35s; }
  .bars i:nth-child(2) { height: 55%; animation-delay: 0.5s; }
  .bars i:nth-child(3) { height: 78%; animation-delay: 0.65s; }
  .bars i:nth-child(4) { height: 100%; animation-delay: 0.8s; animation-name: bar-hot; }

  @keyframes bar {
    to { background: var(--ink); }
  }

  @keyframes bar-hot {
    to { background: var(--accent); }
  }

  h1 {
    font-size: var(--step-hero);
    font-weight: 650;
    letter-spacing: -0.042em;
    line-height: 1;
    max-width: 14.5ch;
  }

  .intro {
    display: grid;
    gap: 1.75rem;
    margin-top: clamp(1.75rem, 1rem + 2.5vw, 3rem);
  }

  .lead {
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.33rem);
    line-height: 1.5;
    max-width: 36rem;
    color: color-mix(in srgb, var(--ink) 82%, var(--paper));
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }

    .actions {
      justify-content: flex-end;
    }
  }

  .facts {
    display: grid;
    gap: 1.5rem 2rem;
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 720px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .facts dt {
    font-weight: 650;
    margin-bottom: 0.3rem;
  }

  .facts dd {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 24rem;
  }

  /* The one orchestrated moment on the page: the hero settles in on load. */
  .reveal {
    animation: rise 0.7s var(--ease) both;
    animation-delay: calc(var(--i) * 90ms + 60ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
