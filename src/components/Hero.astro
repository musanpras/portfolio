---
import { profile } from '../data/profile';

const highlights = [
  { value: '10M+', label: 'downloads of Tring! by Pegadaian, rebuilt in SwiftUI' },
  { value: '2', label: 'apps live on the App Store' },
  { value: '5+', label: 'years shipping mobile and web apps' },
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap">
    <p class="eyebrow rise" style="--i: 0">iOS Engineer in Bali</p>
    <h1 id="hero-title" class="rise" style="--i: 1">{profile.name}</h1>
    <p class="tagline rise" style="--i: 2">Native iOS apps that keep working when the signal drops.</p>
    <div class="actions rise" style="--i: 3">
      <a class="btn" href="#work">See my work</a>
      <a class="more" href={profile.resume} download>Download résumé</a>
    </div>
  </div>

  <div class="wrap-wide">
    <ul class="highlights rise" role="list" style="--i: 4">
      {
        highlights.map((h) => (
          <li>
            <p class="value">{h.value}</p>
            <p class="label">{h.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(4.5rem, 3rem + 7vw, 9rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 5.5rem);
    text-align: center;
  }

  .eyebrow {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.3rem);
    font-weight: 600;
    color: #bf4800;
    letter-spacing: 0.004em;
  }

  :global(:root.is-dark) .eyebrow {
    color: #ff9f0a;
  }

  h1 {
    margin-top: 0.4rem;
    font-size: clamp(3rem, 1.8rem + 5.4vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .tagline {
    margin: 1rem auto 0;
    max-width: 30ch;
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.002em;
    color: var(--text-2);
    text-wrap: balance;
  }

  .actions {
    margin-top: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-size: 17px;
  }

  .highlights {
    display: grid;
    gap: 12px;
    margin-top: clamp(3.5rem, 2.5rem + 5vw, 6.5rem);
  }

  @media (min-width: 760px) {
    .highlights {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  .highlights li {
    padding: clamp(1.4rem, 1rem + 2vw, 2.75rem) 1.5rem;
    border-radius: var(--radius-tile);
    background: var(--tile);
  }

  .value {
    font-size: clamp(2.75rem, 2rem + 2.6vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.015em;
    font-variant-numeric: tabular-nums;
  }

  .label {
    margin: 0.5rem auto 0;
    max-width: 18rem;
    color: var(--text-2);
    font-size: 17px;
  }

  /* One orchestrated entrance on load */
  .rise {
    animation: rise 1s var(--ease) both;
    animation-delay: calc(var(--i) * 110ms + 80ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
</style>
