---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---

<Base title="Page not found, M. Sandy Prastyo" noindex>
  <Header />
  <main id="main" class="wrap nf">
    <h1 class="headline">Page not found.</h1>
    <p class="subhead">Everything lives on the home page.</p>
    <p class="actions"><a class="btn" href="/">Go to the home page</a></p>
  </main>
</Base>

<style>
  .nf {
    min-height: calc(100svh - 48px);
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
  }

  .actions {
    margin-top: 2rem;
  }
</style>
