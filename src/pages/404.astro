---
import Base from '../layouts/Base.astro';
import AppleMark from '../components/AppleMark.astro';
---

<Base title="Page not found, M. Sandy Prastyo" noindex>
  <main id="main" class="wrap nf">
    <AppleMark class="mark" />
    <h1>Nothing here.</h1>
    <p>This page doesn’t exist, or it moved. The portfolio is one page, so everything is on the home page.</p>
    <a class="btn btn--solid" href="/">Go to the home page</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.25rem;
  }

  .nf :global(.mark) {
    width: 44px;
    height: 44px;
  }

  h1 {
    font-size: var(--step-hero);
    letter-spacing: -0.042em;
    line-height: 1;
  }

  p {
    color: var(--muted);
    max-width: 30rem;
  }
</style>
